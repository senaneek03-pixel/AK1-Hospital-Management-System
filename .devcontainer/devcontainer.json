{
  "name": "AK1 Hospital (Tkinter desktop in the browser)",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-desktop.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (open this to see the app)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
